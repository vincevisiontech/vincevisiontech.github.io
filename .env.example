# ----------------------------------------------------------------------------
# VinceVision Technologies — environment variables
# Copy this file to `.env.local` and fill in real values.
# ----------------------------------------------------------------------------

# Anthropic Claude (powers /api/chat). If unset, the chat widget stays visible
# but answers with an email/WhatsApp fallback instead of AI responses.
ANTHROPIC_API_KEY=
# Optional override — defaults to the value in app/api/chat/route.ts
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional custom system prompt suffix (the base prompt is generated from site content)
ANTHROPIC_SYSTEM_SUFFIX=

# Public canonical site URL (used for metadata, sitemap, OG tags, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://vincevisiontech.github.io

# Only set for GitHub *project* pages, e.g. https://user.github.io/repo -> /repo
# Leave empty for the vincevisiontech.github.io root domain.
NEXT_PUBLIC_BASE_PATH=

# Analytics (pick one, both optional — scripts render only when configured)
# Plausible: the registered domain, e.g. vincevisiontech.github.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
